# =============================================================
# Signal Radar — Variáveis de Ambiente
# Copie para .env e preencha com os valores reais.
# NUNCA faça commit do .env — apenas .env.example.
# =============================================================

# ── Supabase (seu projeto próprio) ───────────────────────────
# Dashboard → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ── Backend NestJS (local) ────────────────────────────────────
# URL da API REST
VITE_API_BASE_URL=http://localhost:3001/api

# URL do WebSocket (ws:// local, wss:// em produção)
VITE_API_WS_URL=ws://localhost:3001

# ── Bot4x ─────────────────────────────────────────────────────
# true = motor real habilitado | false = modo demo
VITE_BOT4X_REAL_ENABLED=false

# ── Sentry (opcional) ─────────────────────────────────────────
VITE_SENTRY_DSN=
